# Which LLM provider backend.llm_client uses: "anthropic" or "gemini".
# Defaults to "gemini" when unset.
LLM_PROVIDER=gemini

# REQUIRED when LLM_PROVIDER=gemini (the default) -- the CLI cannot produce
# a single grounded answer without this, though refusals still work fine.
# Get a free key at https://aistudio.google.com/apikey.
# Free-tier limits on that key: 5 requests/minute, 20 requests/day. Each
# multi-turn follow-up costs up to 2 requests (query rewrite + generation),
# so a testing session can exhaust the daily cap in roughly 10 turns -- see
# README.md's Setup section before running a long session on a free key.
GEMINI_API_KEY=

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional. Set to 0 to disable post-hoc grounding verification (Slice 4).
# Verification adds exactly one LLM call per grounded turn -- it re-reads the
# generated answer against the retrieved KB section and scores what fraction
# of its claims are actually supported. Turning it off halves the per-turn
# cost on a quota-constrained key, at the price of the confidence number
# falling back to the retrieval signal alone (reported as
# `verification_disabled`, never presented as a full composite).
# Accepts 0/false/no/off; anything else, or unset, leaves it enabled.
VERIFY_GROUNDING=1
